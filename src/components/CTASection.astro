---
import siteData from '../data/site-data.json';
const { cta } = siteData;
---

<section class="section-padding border-t border-zinc-200 dark:border-zinc-800">
  <div class="section-shell flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{cta.headline}</h2>
      <p class="mt-4 max-w-[65ch] text-zinc-600 dark:text-zinc-400">{cta.subtext}</p>
    </div>
    <div class="flex flex-wrap gap-4">
      <a href={cta.primaryCta.href} class="btn-primary">{cta.primaryCta.text}</a>
      <a
        href={cta.secondaryCta.href}
        class="btn-secondary"
        target="_blank"
        rel="noopener noreferrer">{cta.secondaryCta.text}</a
      >
    </div>
  </div>
</section>
