---
import siteData from "../data/site-data.json";
const { download, cta } = siteData;
---

<section class="border-y border-zinc-200 dark:border-zinc-200 section-padding"  data-theme="dark">
  <div
    class="flex lg:flex-row flex-col lg:justify-between lg:items-end gap-8 section-shell"
  >
    <div>
      <h2 class="font-semibold text-3xl sm:text-4xl tracking-tight">
        {cta.headline}
      </h2>
      <p class="mt-4 max-w-[65ch] text-zinc-00 dark:text-zinc-300">
        {cta.subtext}
      </p>

      <p class="mt-4 mb-3 max-w-[65ch] text-zinc-600 dark:text-zinc-300">
        <b>{cta.docker}</b> {cta.dockertext}
      </p>

      <code
        class="inline-flex items-center space-x-4 bg-gray-900 p-4 pl-6 rounded-lg text-white text-sm sm:text-base text-left"
      >
        <span class="flex gap-4">
          <span class="text-gray-500 shrink-0"> $ </span>
          <span class="flex-1">
            <span> {download.options[1].command}:</span>
            <span class="text-yellow-500">{download.options[1].tag}</span>
          </span>
        </span>
      </code>
    </div>
    <div class="flex flex-wrap gap-4">
      <a href={cta.primaryCta.href} class="btn-primary">{cta.primaryCta.text}</a
      >
      <a
        href={cta.secondaryCta.href}
        class="btn-secondary"
        target="_blank"
        rel="noopener noreferrer">{cta.secondaryCta.text}</a
      >
    </div>
  </div>
</section>
