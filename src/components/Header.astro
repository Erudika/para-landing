---
import siteData from '../data/site-data.json';
import ThemeToggle from './ThemeToggle.astro';
const { nav } = siteData;
---

<header class="sticky top-0 z-30 border-b border-zinc-200 bg-zinc-50/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/90">
  <div class="container-base flex h-16 items-center justify-between gap-4">
    <a href={nav.logo.href} class="flex shrink-0 items-center" aria-label={nav.logo.text}>
      <img src="/images/logo.svg" alt={nav.logo.text} width="112" height="35" class="h-7 w-auto dark:hidden" />
      <img src="/images/footer-logo.svg" alt={nav.logo.text} width="112" height="35" class="hidden h-7 w-auto dark:block" />
    </a>
    <nav class="flex items-center gap-4 sm:gap-6" aria-label="Main">
      {
        nav.links.map((link) => (
          <a
            href={link.href}
            class="font-mono text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.text}
          </a>
        ))
      }
      <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">|</span>
      <ThemeToggle />
    </nav>
  </div>
</header>
