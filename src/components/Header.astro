---
import siteData from "../data/site-data.json";
const { nav, hero } = siteData;
import ParaLogo from "./ParaLogo.astro";
---

<header
  class="top-0 z-30 sticky bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur border-zinc-200 dark:border-zinc-800 border-b"
>
  <div
    class="flex justify-between items-center gap-4 px-8 h-16 container-base navbar"
  >
    <div class="navbar-start">
      <div class="dropdown">
        <div tabindex="0" role="button" class="lg:hidden btn btn-ghost">
          <svg
            aria-label="Menu"
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path d="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" />
          </svg>
        </div>
        <ul
          tabindex="-1"
          class="z-1 bg-base-100 shadow mt-3 p-2 rounded-box w-52 menu menu-sm dropdown-content"
        >
          {
            nav.links.map((link) => (
              <li>
              <a
                href={link.href}
                class="font-mono text-zinc-600 hover:text-zinc-900 dark:hover:text-zinc-100 dark:text-zinc-400 text-sm transition-colors"
                {...(link.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {link.text}
              </a>
              </li>
            ))
          }
        </ul>
      </div>
      <a
        href={nav.logo.href}
        class="flex items-center shrink-0"
        aria-label={nav.logo.text}
      >
        <ParaLogo label={nav.logo.text} class="w-28 h-7" />
      </a>
    </div>
    <div class="hidden lg:flex navbar-center">
      <ul class="px-1 menu menu-horizontal">
        {
            nav.links.map((link) => (
              <li>
              <a
                href={link.href}
                class="font-mono text-zinc-600 hover:text-zinc-900 dark:hover:text-zinc-100 dark:text-zinc-400 text-sm transition-colors"
                {...(link.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {link.text}
              </a>
              </li>
            ))
          }
      </ul>
    </div>
    <div class="max-sm:hidden navbar-end">
      <a href={hero.primaryCta.href} class="btn btn-ghost">{hero.primaryCta.text}</a>
    </div>
  </div>
</header>
