<aside
  id="cookie-consent"
  class="cookie-consent"
  aria-label="Privacy notice"
  hidden
>
  <p class="text-sm">
    This site sets no analytics or advertising cookies. Your theme preference is
    stored only in this browser. Read the <a
      href="/legal/privacy-policy/"
      class="link">privacy policy</a
    >.
  </p>
  <button
    id="cookie-consent-close"
    class="justify-center h-8 cursor-pointer btn-xs btn-primary"
    type="button">Got it</button
  >
</aside>

<script>
  const itemId = "para-consent";
  const consentBanner = document.getElementById("cookie-consent");
  const consentClose = document.getElementById("cookie-consent-close");
  if (consentBanner && !localStorage.getItem(itemId)) {
    consentBanner.hidden = false;
    requestAnimationFrame(() => consentBanner.classList.add("cookie-consent--visible"));
  }
  if (consentClose && consentBanner) {
    consentClose.addEventListener("click", () => {
      localStorage.setItem(itemId, "dismissed");
      consentBanner.classList.remove("cookie-consent--visible");
      consentBanner.hidden = true;
    });
  }
</script>
