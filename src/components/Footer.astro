---
import siteData from '../data/site-data.json';
import ThemeToggle from './ThemeToggle.astro';
import ParaLogo from './ParaLogo.astro';
const { footer, nav, site } = siteData;
---

<footer class="border-zinc-200 dark:border-zinc-800 border-t">
  <div class="py-10 section-shell">
    <div class="flex md:flex-row flex-col sm:justify-between sm:items-start gap-8">
      <div class="max-w-sm">
        <ParaLogo label={site.title} class="w-24 h-7" />
        <p class="mt-4 ascii">{footer.blurb}</p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 mt-11" aria-label={nav.footerLabel}>
        {
          footer.links.map((link) => (
            <a
              href={link.href}
              class="font-mono text-zinc-600 hover:text-zinc-900 dark:hover:text-zinc-100 dark:text-zinc-400 text-sm transition-colors"
              {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            set:html={link.text}>
              
            </a>
          ))
        }
      </nav>
    </div>
    <div class="flex sm:flex-row max-sm:flex-col sm:justify-between max-sm:items-center gap-2 mt-8 pt-6 border-zinc-200 dark:border-zinc-800 border-t font-mono text-zinc-500 dark:text-zinc-500 text-xs">
      <p set:html={footer.credit}></p>
      <p>{footer.license}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
