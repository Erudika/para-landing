---
import siteData from '../data/site-data.json';
import ThemeToggle from './ThemeToggle.astro';
const { footer, nav, site } = siteData;
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="section-shell py-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <img src="/images/logo.svg" alt={site.title} width="96" height="30" class="h-6 w-auto dark:hidden" />
        <img src="/images/footer-logo.svg" alt={site.title} width="96" height="30" class="hidden h-6 w-auto dark:block" />
        <p class="ascii mt-4">{footer.blurb}</p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label={nav.footerLabel}>
        {
          footer.links.map((link) => (
            <a
              href={link.href}
              class="font-mono text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
              {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.text}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-zinc-200 pt-6 font-mono text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
      <p>
        {footer.credit}
      </p>
      <p>{footer.license}</p>
      <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">|</span>
      <ThemeToggle />
    </div>
  </div>
</footer>
