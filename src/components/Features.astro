---
import { Image } from "astro:assets";
import siteData from "../data/site-data.json";
const { features } = siteData;

interface FeatureItem {
  title: string;
  body: string;
  chips?: string[];
  code?: string;
}
const items = features.items as FeatureItem[];
---

<section class="border-zinc-200 dark:border-zinc-800 border-t section-padding">
  <div class="section-shell">
    <h2 class="max-w-[43ch] font-semibold text-3xl sm:text-4xl tracking-tight">
      {features.headline}
    </h2>
    <p class="mt-4 max-w-[65ch] text-zinc-600 dark:text-zinc-400">
      {features.subtext}
    </p>

    <ul
      class="gap-px grid sm:grid-cols-2 bg-zinc-200 dark:bg-zinc-800 mt-12 border border-zinc-200 dark:border-zinc-800 rounded-[4px] overflow-hidden"
    >
      {
        items.slice(0, 8).map((item, i) => (
          <li class="group relative bg-zinc-50 hover:bg-white dark:bg-zinc-950 dark:hover:bg-zinc-900 p-6 transition-colors">
            <div class="float-right m-4">
              <Image
                src={import(`../images/feature${String(i + 1)}-light.png`)}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="dark:hidden w-16"
                style="image-rendering: pixelated;"
              />
              <Image
                src={import(`../images/feature${String(i + 1)}-dark.png`)}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="light:hidden w-16"
                style="image-rendering: pixelated;"
              />
            </div>
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 text-zinc-500/20 dark:text-zinc-500/20 transition-opacity dither"
              aria-hidden="true"
            />
            <div class="aspect-4/1">
              <h3 class="font-mono font-semibold tracking-tight">
                {/* <span class="mr-2 text-zinc-400 dark:text-zinc-600">{String(i + 1).padStart(2, '0')}</span> */}
                {item.title}
              </h3>
              <p class="mt-3 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {item.body}
              </p>
              {item.chips && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {item.chips.map((chip) => (
                    <span class="chip">{chip}</span>
                  ))}
                </div>
              )}
              {item.code && <pre class="code-block mt-4">{item.code}</pre>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
