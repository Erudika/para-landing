---

<div class="client-library-grid">
  {
    sdks.tabs.map((client) => (
      <a
        class="client-library-card"
        href={client.source}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${client.label} client on GitHub`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-[32px] h-[32px] client-library-icon"
        >
          <path d={icons[client.id]} />
        </svg>
        <span class="client-library-name">{client.label}</span>
      </a>
    ))
  }
</div>

<style>
  .client-library-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (min-width: 40rem) {
    .client-library-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .client-library-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  a.client-library-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    min-height: 4.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  a.client-library-card:hover {
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .client-library-icon {
    flex: none;
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    opacity: 60%;
  }

  .client-library-name {
    min-width: 0;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
  }
</style>
