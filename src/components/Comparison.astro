---
import siteData from "../data/site-data.json";
const { comparison } = siteData;
---

<section class="border-zinc-200 dark:border-zinc-800 border-t section-padding">
  <div class="section-shell">
    <h2 class="font-semibold text-3xl sm:text-4xl tracking-tight">
      {comparison.headline}
    </h2>
    <p class="mt-4 max-w-[65ch] text-zinc-600 dark:text-zinc-400">
      {comparison.subtext}
    </p>

    <div
      class="mt-10 border border-zinc-200 dark:border-zinc-800 rounded-[4px] overflow-x-auto"
      tabindex="0"
      role="region"
      aria-label={comparison.caption}
    >
      <table class="w-full text-sm border-collapse">
        <caption class="sr-only">{comparison.caption}</caption>
        <thead>
          <tr
            class="border-zinc-200 dark:border-zinc-800 border-b font-mono text-zinc-800 dark:text-zinc-400 text-xs text-left tracking-wider"
          >
            {
              comparison.columns.map((col, i) => (
                <th
                  scope="col"
                  class={`px-4 py-3 font-medium ${i === 1 ? "bg-gray-500/10 text-brand-700 dark:bg-gray-500/10 dark:text-brand-300" : ""}`}
                >
                  {col}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            comparison.rows.map((row) => (
              <tr class="border-zinc-200 dark:border-zinc-800 border-b last:border-b-0">
                <th
                  scope="row"
                  class="px-4 py-3 font-mono font-medium text-zinc-500 dark:text-zinc-400 text-xs text-left"
                >
                  {row.label}
                </th>
                {row.values.map((value, i) => (
                  <td
                    class={`px-4 py-3 ${
                      i === 0
                        ? "bg-gray-500/10 font-medium text-zinc-900 dark:bg-gray-500/10 dark:text-zinc-100"
                        : value === "no"
                          ? "text-zinc-500 dark:text-zinc-400"
                          : "text-zinc-600 dark:text-zinc-400"
                    }`}
                  >
                    {value}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 max-w-[65ch] text-zinc-600 dark:text-zinc-400">{comparison.jab}</p>

    {comparison.questions.map((item) => (
      <details class="faq my-3 bg-base-100 border border-base-300 rounded-[4px]">
        <summary class="faq-question">{item.q}</summary>
        <div class="faq-answer px-5 text-zinc-600 dark:text-zinc-400 text-sm">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
