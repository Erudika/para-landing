---
import siteData from '../data/site-data.json';
const { cloud } = siteData;
---

<section class="section-padding border-t border-zinc-200 dark:border-zinc-800">
  <div class="section-shell">
    <div class="relative overflow-hidden rounded-[4px] border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
      <div class="dither absolute inset-x-0 top-0 h-6 text-zinc-400/30 dark:text-zinc-500/20" aria-hidden="true"></div>
      <div class="section-shell relative grid gap-10 py-12 lg:grid-cols-[2fr_1fr] lg:items-center">
        <div>
          <p class="chip">{cloud.badge}</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{cloud.headline}</h2>
          <p class="mt-4 max-w-[65ch] text-zinc-600 dark:text-zinc-400">{cloud.subtext}</p>
          <ul class="mt-6 space-y-2">
            {
              cloud.points.map((point) => (
                <li class="flex items-start gap-3 text-sm text-zinc-700 dark:text-zinc-300">
                  <span class="mt-0.5 font-mono text-xs text-brand-600 dark:text-brand-400" aria-hidden="true">
                    {cloud.marker}
                  </span>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-col items-start gap-3 lg:items-end">
          <a href={cloud.cta.href} class="btn-brand" target="_blank" rel="noopener noreferrer">{cloud.cta.text}</a>
          <p class="font-mono text-xs text-zinc-500 dark:text-zinc-500">{cloud.note}</p>
        </div>
      </div>
    </div>
  </div>
</section>
