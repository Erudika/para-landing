        "code": [
          "import ParaClient",
          "",
          "let pc = ParaClient(accessKey: \"app:myapp\", secretKey: \"\")",
          "pc.setEndpoint(\"https://your-para-host\")",
          "",
          "pc.signIn(\"password\", providerToken: \"ada@example.com::PASSWORD\", callback: { session in",
          "    guard session != nil else { return }",
          "",
          "    let draft = ParaObject()",
          "    draft.type = \"user\"",
          "    draft.name = \"Ada\"",
          "    pc.create(draft, callback: { created in",
          "        guard let created else { return }",
          "        pc.read(\"user\", id: created.id, callback: { user in",
          "            guard let user else { return }",
          "            user.name = \"Ada Lovelace\"",
          "            pc.update(user, callback: { updated in",
          "                guard let updated else { return }",
          "                pc.findQuery(\"user\", query: \"*\", callback: { users in",
          "                    print(\"Found \\(users?.count ?? 0) users\")",
          "                    pc.delete(updated)",
          "                })",
          "            })",
          "        })",
          "    })",
          "})"
