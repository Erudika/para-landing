      {
        "id": "android",
        "label": "Android",
        "package": "Gradle · com.erudika:para-client-android",
        "language": "java",
        "source": "https://github.com/Erudika/para-client-android",
        "code": [
          "import android.content.Context;",
          "import android.util.Log;",
          "import com.erudika.para.client.Listener;",
          "import com.erudika.para.client.ParaClient;",
          "import com.erudika.para.core.ParaObject;",
          "import com.erudika.para.core.Sysprop;",
          "import java.util.List;",
          "",
          "void runExample(Context context) {",
          "    ParaClient pc = new ParaClient(\"app:myapp\", null, context);",
          "    pc.setEndpoint(\"https://your-para-host\");",
          "    pc.signIn(\"password\", \"ada@example.com::PASSWORD\", new Listener<Sysprop>() {",
          "        @Override public void onResponse(Sysprop session) {",
          "            if (session == null) return;",
          "            Sysprop draft = new Sysprop();",
          "            draft.setType(\"user\");",
          "            draft.setName(\"Ada\");",
          "            pc.create(draft, new Listener<ParaObject>() {",
          "                @Override public void onResponse(ParaObject created) {",
          "                    if (created == null) return;",
          "                    pc.read(Sysprop.class, created.getId(), new Listener<Sysprop>() {",
          "                        @Override public void onResponse(Sysprop user) {",
          "                            if (user == null) return;",
          "                            user.setName(\"Ada Lovelace\");",
          "                            pc.update(user, new Listener<ParaObject>() {",
          "                                @Override public void onResponse(ParaObject updated) {",
          "                                    if (updated == null) return;",
          "                                    pc.findQuery(\"user\", \"*\", null, new Listener<List<ParaObject>>() {",
          "                                        @Override public void onResponse(List<ParaObject> users) {",
          "                                            Log.d(\"Para\", \"Users: \" + (users == null ? 0 : users.size()));",
          "                                            pc.delete(updated, null);",
          "                                        }",
          "                                    });",
          "                                }",
          "                            });",
          "                        }",
          "                    });",
          "                }",
          "            });",
          "        }",
          "    });",
          "}"
        ]
      }
    ]
