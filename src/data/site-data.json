  "features": {
    "headline": "Bring your own database. Batteries-included. No schema. No lock-in.",
    "subtext": "Para is built from swappable layers, not a monolith. Every capability below ships in the core or as a plugin.",
    "items": [
      {
        "title": "Schemaless objects",
        "body": "Plain JSON in, plain JSON out. No migrations, no ORM ceremony. Works on key-value stores and traditional databases alike."
      },
      {
        "title": "Three layers",
        "body": "Every object is persisted, indexed and cached by default. Swap the database, the search engine and the cache independently."
      },
      {
        "title": "Stateless scaling",
        "body": "No sticky sessions, no node-local state. Scaling out just requires more nodes, not a re-architecture."
      },
      {
        "title": "Multitenant apps",
        "body": "Each App gets its own table, index and cache. Better efficiency and resource utilization."
      },
      {
        "title": "Pluggable modules",
        "body": "SQL, MongoDB, Cassandra or DynamoDB. Lucene or Elasticsearch. Caffeine or Hazelcast. Choose per deployment, not per product.",
        "chips": ["sql", "mongodb", "cassandra", "dynamodb", "lucene", "elasticsearch", "caffeine", "hazelcast"]
      },
      {
        "title": "Built-in auth",
        "body": "JWT, passwordless logins, LDAP, SAML and social login for all the major identity providers.",
        "chips": ["jwt", "social", "passwordless", "ldap", "saml", "oauth2"]
      },
      {
        "title": "Webhooks",
        "body": "Signed webhook payloads on object events. Wire Para into anything that speaks HTTP."
      },
      {
        "title": "MCP server",
        "body": "A built-in MCP server lets AI agents read and write your data directly, with the same permissions as any client."
      }
    ]
  },
  "comparison": {
    "headline": "Why not Supabase?",
    "subtext": "Para is a general-purpose backend, not a hosted database with extras. Different trade-offs, fewer lock-ins. ",
    "columns": ["", "Para", "Supabase", "Firebase", "Parse"],
    "rows": [
