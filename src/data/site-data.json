        "code": [
          "import com.erudika.para.client.ParaClient;",
          "import com.erudika.para.core.ParaObject;",
          "import com.erudika.para.core.Sysprop;",
          "import java.util.List;",
          "",
          "ParaClient pc = new ParaClient(\"app:myapp\", \"secret\");",
          "pc.setEndpoint(\"http://localhost:8080\");",
          "",
          "Sysprop draft = new Sysprop();",
          "draft.setType(\"user\");",
          "draft.setName(\"Ada\");",
          "ParaObject created = pc.create(draft);",
          "",
          "ParaObject user = pc.read(\"user\", created.getId());",
          "user.setName(\"Ada Lovelace\");",
          "ParaObject updated = pc.update(user);",
          "",
          "List<ParaObject> users = pc.findQuery(\"user\", \"*\");",
          "pc.delete(updated);"
        ]
