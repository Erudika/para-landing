---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cloud_page } from '../data/site-data.json';
import PricingCards from '@/components/PricingCards.astro';
import { Image } from 'astro:assets';
import icon from '../images/para_cloud.svg';
import herobg from '../images/cloudbg.png';

const iconPaths: Record<string, string> = {
  zap: 'M13 10V3L4 14h7v7l9-11h-7z',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  battery: 'M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3',
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  cloud: 'M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z',
  thumb: 'M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282m0 0h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H13.48c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.904m10.598-9.75H14.25M5.904 18.5c.083.205.173.405.27.602.197.4-.078.898-.523.898h-.908c-.889 0-1.713-.518-1.972-1.368a12 12 0 0 1-.521-3.507c0-1.553.295-3.036.831-4.398C3.387 9.953 4.167 9.5 5 9.5h1.053c.472 0 .745.556.5.96a8.958 8.958 0 0 0-1.302 4.665c0 1.194.232 2.333.654 3.375Z',
  search: 'M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z',
  code: 'M7 4a2 2 0 0 0 -2 2v3a2 3 0 0 1 -2 3a2 3 0 0 1 2 3v3a2 2 0 0 0 2 2 M17 4a2 2 0 0 1 2 2v3a2 3 0 0 0 2 3a2 3 0 0 0 -2 3v3a2 2 0 0 1 -2 2',
  refresh: 'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99',
}
---
<BaseLayout
  title={cloud_page.title_short}
  description={cloud_page.description}
>
  <!-- Hero -->
  <section class="bg-cover section-padding" style={`background-image: url(${herobg.src});`}>
    <div class="mx-auto px-6 sm:px-8 max-w-3xl text-white text-center">
      <!-- <p class="mb-6 chip">{cloud_page.badge}</p> -->
      <Image src={icon} width={100} alt={cloud_page.image_alt} loading="eager" fetchpriority="high" class="inline-block mb-6" />
      <h1 class="mb-5 font-semibold text-4xl sm:text-5xl text-balance tracking-tight">
        {cloud_page.title}
      </h1>
      <p class="mb-4 text-zinc-200 text-lg leading-relaxed">
        {cloud_page.subtitle}
      </p>
      <p class="mx-auto mb-8 max-w-2xl text-zinc-200 text-base leading-relaxed">
        {cloud_page.hero_text}
      </p>
      <div class="gap-3 aura aura-sm aura-silver">
        <a
          href={cloud_page.url}
          class="bg-neutral-950 text-white btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >{cloud_page.explore_cta_label}</a>
      </div>
    </div>
  </section>

  <PricingCards pageBlock={cloud_page} title={cloud_page.subscriptions} />

  <!-- Features grid -->
  <section class="border-zinc-200 dark:border-zinc-800 border-t section-padding">
    <div class="section-shell">
      <div class="mx-auto">
        <h2 class="font-semibold text-3xl sm:text-4xl text-center tracking-tight">
          {cloud_page.features_title}
        </h2>
      </div>
      <div class="gap-6 grid sm:grid-cols-2 lg:grid-cols-3 mt-12">
        {cloud_page.features.map((feature) => (
          <div class="card">
            <div class="flex justify-center items-center bg-neutral-700 mb-4 rounded-[4px] w-10 h-10">
              <svg class="w-5 h-5 text-blue-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[feature.icon] ?? iconPaths.zap}/>
              </svg>
            </div>
            <h3 class="font-mono font-semibold text-zinc-900 dark:text-zinc-100">{feature.title}</h3>
            <p class="mt-2 text-zinc-600 dark:text-zinc-400 text-sm text-justify leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cloud vs Self-hosted comparison -->
  <section class="border-zinc-200 dark:border-zinc-800 border-t section-padding">
    <div class="mx-auto px-6 sm:px-8 max-w-3xl">
      <h2 class="mb-8 font-semibold text-3xl sm:text-4xl text-center tracking-tight">{cloud_page.comparison.title}</h2>
      <div class="overflow-x-auto">
        <table class="table-zebra w-full text-sm">
          <thead>
            <tr class="border-zinc-200 dark:border-zinc-800 border-b">
              {cloud_page.comparison.headers.map((header, i) => (
                <th class:list={[
                  'py-3 font-semibold text-zinc-800 dark:text-zinc-200 px-3',
                  i === 0 ? 'text-left pl-4  w-1/2' : i === 1 ? 'text-left px-4 font-bold' : 'text-right text-zinc-500 dark:text-zinc-400',
                ]}>
                  {header}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            {cloud_page.comparison.rows.map((row) => (
              <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900">
                <td class="py-3 pl-4 font-medium text-zinc-700 dark:text-zinc-300">{row[0]}</td>
                <td class="px-4 py-3 font-medium text-left">{row[1]}</td>
                <td class="px-3 py-3 text-zinc-600 dark:text-zinc-400 text-right">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Cloud FAQ -->
  <section class="border-zinc-200 dark:border-zinc-800 border-t section-padding">
    <div class="mx-auto px-6 sm:px-8 max-w-3xl">
      <div class="mb-10 text-center">
        <h2 class="mb-3 font-semibold text-3xl sm:text-4xl tracking-tight">{cloud_page.pricing_faq.title}</h2>
        <p class="text-zinc-600 dark:text-zinc-400">{cloud_page.pricing_faq.subtitle}</p>
      </div>
      {cloud_page.pricing_faq.items.map((item) => (
      <div class="collapse collapse-arrow bg-base-100 my-3 border border-base-300">
        <input type="checkbox" class="peer" />
        <div class="collapse-title">{item.q}</div>
        <div class="collapse-content px-5 text-zinc-600 dark:text-zinc-400 text-sm">
          {item.a}
        </div>
      </div>
      ))}
    </div>
  </section>
</BaseLayout>
