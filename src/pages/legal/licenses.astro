---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, components, licenses_page } from '../../data/site-data.json';
import LICENSE from '../../../LICENSE?raw';

const { breadcrumbs } = components;
const baseUrl = site.url;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: breadcrumbs.home, item: baseUrl },
    { "@type": "ListItem", position: 2, name: breadcrumbs.legal, item: `${baseUrl}/legal/` },
    { "@type": "ListItem", position: 3, name: licenses_page.title, item: `${baseUrl}/legal/licenses/` }
  ]
};
---

<BaseLayout
  title={licenses_page.title}
  description={licenses_page.description}
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="section-padding">
    <div class="mx-auto px-6 sm:px-8 max-w-3xl">
      <div class="mb-10">
        <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
          <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">{breadcrumbs.home}</a>
          <span class="mx-1.5 text-zinc-400">/</span>
          <a href="/legal/" class="hover:text-brand-600 dark:hover:text-brand-400">{breadcrumbs.legal}</a>
        </span>
        <h1 class="mb-4 mt-4 font-semibold text-zinc-900 dark:text-zinc-100 text-4xl tracking-tight">{licenses_page.title}</h1>
        <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {licenses_page.subtitle}
        </p>
      </div>

      <div class="card">
        <div class="flex flex-wrap justify-between items-start gap-4">
          <h2 class="font-mono font-semibold text-zinc-900 dark:text-zinc-100">{licenses_page.license_name}</h2>
          <a
            href={licenses_page.license_url}
            class="link text-sm"
            target="_blank"
            rel="noopener noreferrer"
          >
            {licenses_page.license_link_label}
          </a>
        </div>
        <p class="mt-3 text-zinc-600 dark:text-zinc-400 text-sm">{licenses_page.note}</p>
        <pre class="mt-6 p-5 border border-zinc-200 dark:border-zinc-800 rounded-[4px] overflow-x-auto font-mono text-zinc-700 dark:text-zinc-300 text-xs leading-relaxed whitespace-pre-wrap">{LICENSE}</pre>
      </div>
    </div>
  </section>
</BaseLayout>
