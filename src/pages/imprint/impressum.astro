---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, components, imprint } from '../../data/site-data.json';
const { impressum, impressum_page } = imprint;

const { breadcrumbs } = components;
const baseUrl = site.url;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: breadcrumbs.home, item: baseUrl },
    { "@type": "ListItem", position: 2, name: breadcrumbs.imprint, item: `${baseUrl}/imprint/impressum/` }
  ]
};
---

<BaseLayout
  title={impressum_page.title}
  description={impressum_page.subtitle}
  jsonLd={[breadcrumbJsonLd]}
  noindex={true}
>
  <section class="section-padding">
    <div class="mx-auto px-6 sm:px-8 max-w-2xl">
      <div class="mb-10">
        <span class="font-mono text-zinc-500 dark:text-zinc-400 text-xs">
          <a href="/" class="link">{breadcrumbs.home}</a>
          <span class="mx-1.5 text-zinc-400">/</span>
          <span>{breadcrumbs.imprint}</span>
        </span>
        <h1 class="mt-4 mb-4 font-semibold text-zinc-900 dark:text-zinc-100 text-4xl tracking-tight">{impressum_page.title}</h1>
        <p class="text-zinc-600 dark:text-zinc-400">{impressum_page.subtitle}</p>
      </div>

      <div class="space-y-5 bg-zinc-50 dark:bg-zinc-900 p-6 border border-zinc-200 dark:border-zinc-800 rounded-[4px]">
        <div>
          <h2 class="mb-1 font-mono font-semibold text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wider">{impressum_page.labels.company_name}</h2>
          <p class="font-medium text-zinc-900 dark:text-zinc-100">{impressum.company}</p>
        </div>
        <div>
          <h2 class="mb-1 font-mono font-semibold text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wider">{impressum_page.labels.registered_address}</h2>
          <p class="text-zinc-900 dark:text-zinc-100">{impressum.address}</p>
          <p class="text-zinc-900 dark:text-zinc-100">{impressum.country}</p>
        </div>
        <div>
          <h2 class="mb-1 font-mono font-semibold text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wider">{impressum_page.labels.vat_number}</h2>
          <p class="text-zinc-900 dark:text-zinc-100">{impressum.vat}</p>
        </div>
        <div>
          <h2 class="mb-1 font-mono font-semibold text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wider">{impressum_page.labels.managing_director} <span lang="bg">(МОЛ)</span></h2>
          <p class="text-zinc-900 dark:text-zinc-100">{impressum.managing_director}</p>
        </div>
        <div>
          <h2 class="mb-1 font-mono font-semibold text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wider">{impressum_page.labels.email}</h2>
          <a href={`mailto:${impressum.email}`} class="hover:underline link">{impressum.email}</a>
        </div>
        <div>
          <h2 class="mb-1 font-mono font-semibold text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wider">{impressum_page.labels.website}</h2>
          <a href={impressum.website} class="hover:underline link" target="_blank" rel="noopener noreferrer">
            {impressum.website}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
